#!/usr/bin/env bash
set -euo pipefail
# Small wrapper for environments where the standard Gradle wrapper JAR is not bundled.
GRADLE_VERSION="8.4"
BASE="${GRADLE_USER_HOME:-$HOME/.gradle}/pcwork-wrapper"
DIST="$BASE/gradle-$GRADLE_VERSION"
if [[ ! -x "$DIST/bin/gradle" ]]; then
  mkdir -p "$BASE"
  ARCHIVE="$BASE/gradle-$GRADLE_VERSION-bin.zip"
  if [[ ! -f "$ARCHIVE" ]]; then
    curl --fail --location --retry 3 "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" --output "$ARCHIVE"
  fi
  unzip -q -o "$ARCHIVE" -d "$BASE"
fi
exec "$DIST/bin/gradle" "$@"
